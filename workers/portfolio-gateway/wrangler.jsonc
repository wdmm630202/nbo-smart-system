{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "nanbo-portfolio-gateway",
  "main": "worker.js",
  "compatibility_date": "2026-08-14",
  "workers_dev": true,
  "secrets": {
    "required": ["PORTFOLIO_INSIGHTS_TOKEN", "WECHAT_BROKER_SECRET"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nanbo-portfolio-analytics",
      "database_id": "1f0ace6f-8004-4ee2-abc4-d0794dba2bdb"
    }
  ],
  "routes": [
    {
      "pattern": "p.nanbostudio.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
